# Synapse server configuration (names only; never commit real values).

# Address the sync server listens on, e.g. 127.0.0.1:7878
SYNAPSE_BIND=
# Directory holding server-side graphs and blobs
SYNAPSE_DATA_DIR=
# Bearer token clients must present (generate a long random string)
SYNAPSE_AUTH_TOKEN=
# Log filter, e.g. info,synapse_server=debug
RUST_LOG=
