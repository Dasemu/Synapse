# Synapse server configuration (names only; never commit real values).

# Address the sync server listens on, e.g. 127.0.0.1:7878 (default if empty)
SYNAPSE_BIND=
# Directory holding server-side graphs and blobs (required)
SYNAPSE_DATA_DIR=
# Bearer token(s) clients must present, comma separated, each >= 16 chars
# (generate with `openssl rand -hex 32`; required)
SYNAPSE_AUTH_TOKEN=
# Token that authorises POST /admin/update (self-update). Endpoint disabled if empty.
SYNAPSE_UPDATE_TOKEN=
# Update script run by the endpoint (default /opt/synapse/scripts/update.sh)
SYNAPSE_UPDATE_SCRIPT=
# Reject pushed ops whose clock is more than this many minutes ahead of the server (default 10)
SYNAPSE_MAX_CLOCK_SKEW_MINUTES=
# MCP endpoint (/v1/graphs/{id}/mcp) bearer token(s), comma separated, each >= 16 chars,
# separate from SYNAPSE_AUTH_TOKEN. MCP disabled if empty. See docs/mcp.md.
SYNAPSE_MCP_TOKEN=
# Set to 1 to expose the MCP write tools (page curation; journals stay read-only)
SYNAPSE_MCP_ALLOW_WRITE=
# Host headers the MCP endpoint accepts, comma separated (default localhost,127.0.0.1,::1;
# set your public hostname behind a proxy, or * for any)
SYNAPSE_MCP_ALLOWED_HOSTS=
# Log format: text (default) or json
SYNAPSE_LOG_FORMAT=
# Log filter, e.g. info,synapse_server=debug
RUST_LOG=
