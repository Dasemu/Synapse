# Build-time environment variables read by the build/CLI scripts.
# No runtime secrets are required to build or run this repo locally.

# Standard Node environment ("development" | "production").
NODE_ENV=

# Set to "1" to skip bundling the OCaml CLI into desktop releases
# (used in CI; see .gitea/workflows/build.yml).
LOGSEQ_SKIP_CLI_BUNDLE=

# Override the resolved CLI package version/build metadata (optional).
LOGSEQ_BUILD_TIME=
LOGSEQ_REVISION=
