# Synapse server configuration (names only; never commit real values).

# Address the sync server listens on, e.g. 127.0.0.1:7878 (default if empty)
SYNAPSE_BIND=
# Directory holding server-side graphs and blobs (required)
SYNAPSE_DATA_DIR=
# Bearer token(s) clients must present, comma separated, each >= 16 chars
# (generate with `openssl rand -hex 32`; required)
SYNAPSE_AUTH_TOKEN=
# Token that authorises POST /admin/update (self-update). Endpoint disabled if empty.
SYNAPSE_UPDATE_TOKEN=
# Update script run by the endpoint (default /opt/synapse/scripts/update.sh)
SYNAPSE_UPDATE_SCRIPT=
# Log format: text (default) or json
SYNAPSE_LOG_FORMAT=
# Log filter, e.g. info,synapse_server=debug
RUST_LOG=
